# =============================================================================
# ルート .env.example — Docker Compose 用設定のひな形
# =============================================================================
# 使い方: このファイルをコピーして .env を作成してください。
#
#   cp .env.example .env
#
# .env が無いと `docker compose up` は起動に失敗します。
#
# 【重要】.env は2つあります。役割が違うので混同しないでください。
#   ・このファイル              … Docker の構成専用
#   ・customer-management_app/.env … Laravel アプリ本体の設定
#
# このファイルのうち Docker が実際に使うのは、次の7項目だけです。
#   APP_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD /
#   DB_ROOT_PASSWORD / DB_PORT_HOST / PMA_PORT
# それ以外の項目は、2つの .env を見比べやすいように並べてあるだけで、
# アプリの動作には customer-management_app/.env の値が使われます。
#
# DB_DATABASE / DB_USERNAME / DB_PASSWORD の3つは
# 「MySQL が作るユーザー」と「Laravel が接続するユーザー」なので、
# 両ファイルで必ず同じ値にしてください。食い違うと DB 接続エラーになります。
#
# "change_this_" で始まる値は、必ず自分で決めた値に変更してください。
# =============================================================================

# --- アプリケーション基本情報 -------------------------------------------------
APP_NAME="Patron Hub"

# local(開発) / production(本番)。本番は必ず production にしてください。
APP_ENV=local

# ※ このファイルの APP_KEY は使われません。空のままにしてください。
#   実際に使われるのは customer-management_app/.env の APP_KEY です。
#   （`php artisan key:generate` もあちらのファイルだけを書き換えます）
APP_KEY=

# エラーの詳細をブラウザに表示するか。本番では必ず false のままにしてください
# （true にするとファイルパスや設定値が外部に漏れます）。
APP_DEBUG=false

# アプリのURL。下の APP_PORT と番号を合わせてください。
APP_URL=http://localhost:8080

# ブラウザからアクセスするポート番号（http://localhost:この番号）。
# 8080 が他のアプリで使用中の場合はここを変更します（例: 8888）。
APP_PORT=8080

# --- 言語・タイムゾーン -------------------------------------------------------
APP_LOCALE=ja           # 表示言語
APP_FALLBACK_LOCALE=ja  # 翻訳が見つからないときに使う言語
APP_TIMEZONE=Asia/Tokyo # 日時の基準（登録日時などの表示に影響します）

# --- ログ --------------------------------------------------------------------
LOG_CHANNEL=stack
# 記録する深刻度の下限。warning は「警告以上のみ記録」の意味です。
# 不具合調査時は debug にすると詳細が出ます（ログ量が大幅に増えます）。
LOG_LEVEL=warning

# --- データベース接続 ---------------------------------------------------------
DB_CONNECTION=mysql

# 接続先ホスト名。compose.yaml のサービス名がそのままホスト名になります。
# コンテナ間の通信なので "localhost" ではなく "db" です。
DB_HOST=db

# コンテナ内での MySQL ポート。変更する必要はありません。
# （PCの DB クライアントから繋ぐときは下の DB_PORT_HOST を使います）
DB_PORT=3306

# 初回起動時に自動作成されるデータベース名。
DB_DATABASE=customer_manager

# 同じく自動作成されるアプリ用ユーザー。アプリはこのユーザーで接続します。
# パスワードの生成例: openssl rand -hex 16
DB_USERNAME=customer_user
DB_PASSWORD=change_this_password

# MySQL の管理者パスワード。アプリは使いません。
# healthcheck（DB の起動確認）と、手動でのDBメンテナンス用です。
DB_ROOT_PASSWORD=change_this_root_password

# PC の DB クライアント（TablePlus / A5:SQL Mk-2 等）から接続するための
# ホスト側ポート番号です。接続先は 127.0.0.1:3307 になります。
# PC に MySQL を直接入れている場合の衝突を避けるため 3306 ではなく 3307 です。
# ※ この設定はこのファイル（Docker用）だけで使います。
DB_PORT_HOST=3307

# phpMyAdmin を開くポート番号（http://localhost:8090）。
# アプリの 8080 と重ならない番号にしてください。
# 8081〜8086 は VS Code が使うことがあるため 8090 にしています。
PMA_PORT=8090

# --- セッション（ログイン状態の保持） ------------------------------------------
SESSION_DRIVER=database    # セッションを DB の sessions テーブルに保存
SESSION_LIFETIME=30        # 無操作で自動ログアウトするまでの分数
SESSION_ENCRYPT=true       # セッション内容を暗号化して保存
SESSION_SECURE_COOKIE=false # HTTPS でのみ Cookie を送るか。
                            # 本番(HTTPS)では必ず true にしてください。
                            # ローカルは http のため false です。
SESSION_HTTP_ONLY=true     # JavaScript から Cookie を読めなくする(XSS対策)
SESSION_SAME_SITE=lax      # 外部サイトからの Cookie 送信を制限(CSRF対策)

# --- 自動ログインの有効日数 ---------------------------------------------------
# 「ログイン状態を保持する」を使っても、最後にログインした日からこの日数が
# 過ぎると強制的にログアウトします。0 にすると期限なしになります。
LOGIN_MAX_DAYS=3

# --- キャッシュ・キュー -------------------------------------------------------
CACHE_STORE=database       # キャッシュを cache テーブルに保存
QUEUE_CONNECTION=database  # 非同期処理を jobs テーブルに保存

# --- パスワードのハッシュ方式 --------------------------------------------------
# argon2id は現在推奨される方式です。平文では保存されません。
HASH_DRIVER=argon2id

# --- 検索用ハッシュキー -------------------------------------------------------
# 電話番号・メールアドレスは暗号化されるため、そのままでは検索できません。
# そこで別途 HMAC-SHA256 のハッシュ値を保存し、検索に使います。その鍵です。
# 【警告】運用開始後に変更すると、既存データが検索でヒットしなくなります。
# 生成方法: openssl rand -base64 32
SEARCH_HASH_KEY=change_this_search_hash_key
