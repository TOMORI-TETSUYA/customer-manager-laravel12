# =============================================================================
# customer-management_app/.env.example — Laravel アプリ本体の設定のひな形
# =============================================================================
# 使い方: このファイルをコピーして .env を作成してください。
#
#   cp customer-management_app/.env.example customer-management_app/.env
#
# Laravel が実際に読み込むのはこちらのファイルです。
# ルートの .env は Docker の構成用（別物）なので、両方が必要です。
#
# 【必ず一致させる項目】ルート .env と以下がズレると DB 接続に失敗します。
#   DB_DATABASE / DB_USERNAME / DB_PASSWORD
#
# このファイルは Web からアクセスできない場所（customer-management_app/）に
# 置かれています。公開ディレクトリ（customer-management/）へは移動しないでください。
#
# "change_this_" で始まる値は、必ず自分で決めた値に変更してください。
# =============================================================================

# --- アプリケーション基本情報 -------------------------------------------------
APP_NAME="Patron Hub"

# local(開発) / production(本番)。本番は必ず production にしてください。
APP_ENV=local

# 暗号化キー。空のままだとアプリが起動しません。
# `docker compose exec app php artisan key:generate` で自動生成されます。
# 【警告】顧客の氏名・電話・住所はこのキーで暗号化されています。
# 運用開始後に変更すると既存データが復号できなくなります。
# バックアップ時は必ずこの値も一緒に保管してください。
APP_KEY=

# エラーの詳細をブラウザに表示するか。本番では必ず false のままにしてください
# （true にするとファイルパスや設定値が外部に漏れます）。
APP_DEBUG=false

# アプリのURL。メール内リンクの生成などに使われます。
# ローカル開発時はこのままで構いませんが、本番ではリバースプロキシ（ホストの
# nginx）が終端している公開URLに変更してください
# （例: APP_URL=https://customer-manager.post-house-system.com）。
# ここを http://localhost:8090 のままにすると、キューワーカーや artisan
# コマンドなど HTTP リクエストの外側で生成される URL が誤ったものになります。
APP_URL=http://localhost:8090

# ※ Laravel はこの値を使いません（ルート .env の Docker 用設定です）。
#   ポートを変えるときは、上の APP_URL と合わせて修正してください。
APP_PORT=8090

# --- 言語・タイムゾーン -------------------------------------------------------
APP_LOCALE=ja           # 表示言語
APP_FALLBACK_LOCALE=ja  # 翻訳が見つからないときに使う言語
APP_TIMEZONE=Asia/Tokyo # 日時の基準（登録日時などの表示に影響します）

# --- ログ --------------------------------------------------------------------
# 出力先は customer-management_app/storage/logs/laravel.log です。
LOG_CHANNEL=stack
# 記録する深刻度の下限。warning は「警告以上のみ記録」の意味です。
# 不具合調査時は debug にすると詳細が出ます（ログ量が大幅に増えます）。
LOG_LEVEL=warning

# --- データベース接続 ---------------------------------------------------------
DB_CONNECTION=mysql

# 接続先ホスト名。compose.yaml のサービス名がそのままホスト名になります。
# アプリはコンテナ内で動くため "localhost" ではなく "db" です。
DB_HOST=db

# コンテナ間通信のポート。ルート .env の DB_PORT_HOST(3307) とは別物で、
# こちらは変更しないでください。
DB_PORT=3306

# ↓↓↓ この3つはルート .env と必ず同じ値にしてください ↓↓↓
DB_DATABASE=customer_manager
DB_USERNAME=customer_user
DB_PASSWORD=change_this_password

# ※ Laravel はこの値を使いません（MySQL の管理者パスワード）。
#   ルート .env 側で healthcheck に使われます。
DB_ROOT_PASSWORD=change_this_root_password

# --- セッション（ログイン状態の保持） ------------------------------------------
SESSION_DRIVER=database    # セッションを DB の sessions テーブルに保存
SESSION_LIFETIME=30        # 無操作で自動ログアウトするまでの分数
SESSION_ENCRYPT=true       # セッション内容を暗号化して保存
SESSION_SECURE_COOKIE=false # HTTPS でのみ Cookie を送るか。
                            # 本番(HTTPS)では必ず true にしてください。
                            # ローカルは http のため false です。
SESSION_HTTP_ONLY=true     # JavaScript から Cookie を読めなくする(XSS対策)
SESSION_SAME_SITE=lax      # 外部サイトからの Cookie 送信を制限(CSRF対策)

# --- 自動ログインの有効日数 ---------------------------------------------------
# ログイン画面の「ログイン状態を保持する」を使った場合でも、最後にログインした
# 日からこの日数が過ぎると強制的にログアウトし、再ログインを求めます。
# 操作を続けていても期限は延びません（SESSION_LIFETIME とは別の上限です）。
# 0 にすると期限なしになります。
LOGIN_MAX_DAYS=3

# --- ログイン試行の制限と応答遅延 ---------------------------------------------
# 「ログインID + IPアドレス」の組み合わせごとに数えます。
LOGIN_MAX_ATTEMPTS=3    # 許可する試行回数。これを超えるとブロック
LOGIN_DECAY_MINUTES=60  # ブロックが解除されるまでの時間（分）
LOGIN_FAILED_DELAY=10   # ログイン失敗時、応答を返すまで待つ秒数
LOGIN_BLOCKED_DELAY=120 # ブロック中の要求に対し、応答を返すまで待つ秒数

# --- 顧客の担当者に指定できないログインID -------------------------------------
# システムの運用管理用アカウントを、顧客の「担当者」の選択肢から外します。
# 画面に表示されないだけでなく、サーバー側でも指定を拒否します。
# 複数指定する場合はカンマ区切り（例: admin,system）。空にすると全員が選べます。
NON_ASSIGNABLE_LOGIN_IDS=admin
#
# 【注意】遅延中は PHP のプロセスを1つ占有します。同時に遅延できる数は
# docker/php/www.conf の pm.max_children（現在40）が上限です。
# 遅延秒数を延ばす場合は、次の3つも必ず一緒に大きくしてください。
#   ・docker/php/php.ini        max_execution_time（現在180）
#   ・docker/php/www.conf       request_terminate_timeout（現在180s）
#   ・docker/nginx/default.conf fastcgi_read_timeout（現在180s）
# 遅延を無効にするには 0 を指定します。

# --- キャッシュ・キュー -------------------------------------------------------
CACHE_STORE=database       # キャッシュを cache テーブルに保存
QUEUE_CONNECTION=database  # 非同期処理を jobs テーブルに保存

# --- パスワードのハッシュ方式 --------------------------------------------------
# argon2id は現在推奨される方式です。平文では保存されません。
# ログインパスワードは12文字以上が必須です。
HASH_DRIVER=argon2id

# --- 検索用ハッシュキー -------------------------------------------------------
# 電話番号・メールアドレスは暗号化されるため、そのままでは検索できません。
# そこで別途 HMAC-SHA256 のハッシュ値(phone_hash / email_hash)を保存し、
# 検索に使います。その鍵です。APP_KEY とは別の鍵にしてください。
# 【警告】運用開始後に変更すると、既存データが検索でヒットしなくなります。
# 生成方法: openssl rand -base64 32
SEARCH_HASH_KEY=change_this_search_hash_key
